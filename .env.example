# Token from @BotFather
BOT_TOKEN=
# Your Telegram user ID (e.g. from @userinfobot): receives leads, bookings and /admin access
MANAGER_CHAT_ID=
# Shown as the "Хочу такой бот" button; leave empty to hide
OWNER_CONTACT=https://t.me/your_username
NOTIFY_DEMO_VISITS=true

# Servers in Russia: Bot API mirror (Cloudflare Worker) if api.telegram.org is unreachable
TELEGRAM_API_URL=

# YandexGPT via Yandex AI Studio. Without a key the assistant answers with knowledge-base fragments.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5-lite/latest

# Optional: every lead is POSTed here as JSON (amoCRM / Bitrix24 incoming webhook, etc.)
CRM_WEBHOOK_URL=

TIMEZONE=Europe/Moscow
DAILY_QUESTION_LIMIT=30
DEMO_REMINDER_SECONDS=60
REMINDER_BEFORE_MINUTES=120
